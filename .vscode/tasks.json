{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Manual auto-push watcher",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\.vscode\\auto-push.ps1"
			],
			"isBackground": true,
			"problemMatcher": [],
			"presentation": {
				"reveal": "never",
				"panel": "dedicated",
				"focus": false
			},
			"runOptions": {
				"instanceLimit": 1
			}
		}
	]
}